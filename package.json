{
  "name": "api-evaluator",
  "version": "0.7.7",
  "private": false,
  "description": "Self-hosted evaluation platform for any OpenAI-compatible / Claude-compatible API gateway or relay: connectivity, stability, scenario and admission tests with cost estimates and exportable reports.",
  "license": "MIT",
  "type": "module",
  "author": "API-evaluator contributors",
  "homepage": "https://github.com/yl0711-coder/API-evaluator#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yl0711-coder/API-evaluator.git"
  },
  "bugs": {
    "url": "https://github.com/yl0711-coder/API-evaluator/issues"
  },
  "keywords": [
    "llm",
    "evaluation",
    "openai-compatible",
    "claude",
    "api-gateway",
    "relay",
    "benchmark",
    "model-testing"
  ],
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node server.mjs",
    "start": "node server.mjs",
    "build": "vite build",
    "check": "node --check server.mjs",
    "check:text": "node scripts/check-text-source.mjs",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "test:e2e": "playwright test",
    "compare:eval": "node scripts/compare-eval-reports.mjs",
    "check:egress": "node scripts/check-egress-mitigation.mjs",
    "test": "node --test tests/*.test.mjs",
    "fingerprint:baseline": "node --env-file=.env.evaluator scripts/claude-token-baseline.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@playwright/test": "1.55.0",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.4.0",
    "mysql2": "^3.22.5",
    "nodemailer": "9.0.3"
  }
}
