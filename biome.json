{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "server.mjs",
      "vite.config.js",
      "playwright.config.mjs",
      "index.html",
      "package.json",
      "server/**",
      "src/**",
      "shared/**",
      "scripts/**",
      "tests/**",
      "e2e/**",
      "!src/docs/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 140
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
